# Copy this file to .env, or just leave it as-is — every value below has a
# working default already, so a plain "docker compose up" works with no .env
# at all. Nothing here is a secret or credential; Routy needs no API keys.

# Where persistent data (the SQLite database) is stored on the HOST.
# Point this at wherever you keep appdata/config for your other containers —
# e.g. /volume1/docker/routy on Synology, /mnt/user/appdata/routy on unRAID —
# so it lives outside this project checkout and survives updates, `git pull`,
# or Docker itself being wiped. Defaults to a "data" folder next to
# docker-compose.yml if left unset.
DATA_DIR=./data

# Whether login cookies are marked "Secure" (only sent over HTTPS). Leave this
# as "true" if every path you access Routy through terminates HTTPS before
# reaching it (Cloudflare Tunnel does this at their edge; Caddy does this by
# default too) — which is the normal case. Set to "false" only if you find
# login doesn't stick on some path that turns out to serve plain HTTP.
COOKIE_SECURE=true
