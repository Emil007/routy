# Copy this file to .env (or set these as environment variables in docker-compose.yml)

# Where the SQLite database file lives. Inside the Docker image this should stay
# under the mounted volume so data survives container restarts/updates.
DATABASE_PATH=/app/data/routy.db

# Whether login cookies are marked "Secure" (only sent over HTTPS). Leave this as
# "true" if a reverse proxy in front of Routy terminates HTTPS (the recommended
# setup). Set to "false" only if you access Routy over plain HTTP.
COOKIE_SECURE=true
